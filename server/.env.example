# ==============================================================================
# Sai Prudent Scholarship Examination Portal - Backend Environment Config
# Neon PostgreSQL Connection URL
# ==============================================================================

PORT=5000

# Paste your Neon DB connection string here:
# Example: postgresql://[user]:[password]@[endpoint].neon.tech/neondb?sslmode=require
DATABASE_URL=

# ==============================================================================
# Admin Console credentials (seeded into the admins table on first run only).
# Change these before deploying — if left unset, the insecure default
# admin / admin123 is used and a warning is printed on server start.
# ==============================================================================
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Secret used to sign admin session tokens (any long random string).
# If left unset, a random secret is generated per process start, which means
# admin sessions won't survive a server restart. Set a fixed value in production.
JWT_SECRET=

# ==============================================================================
# CORS: the deployed frontend's exact URL (no trailing slash), e.g. a Netlify
# or Vercel custom domain. Comma-separate multiple exact origins, e.g. a custom
# domain plus the platform's own *.netlify.app/*.vercel.app URL.
# ==============================================================================
FRONTEND_URL=

# Optional: your Netlify/Vercel site name, so that platform's preview/branch
# deploy URLs for THIS site are allowed too (e.g. "sai-prudent" matches
# "deploy-preview-12--sai-prudent.netlify.app"). Leave unset if you don't need
# preview deploys to reach the API — only exact FRONTEND_URL matches are needed.
NETLIFY_SITE_NAME=
VERCEL_PROJECT_NAME=

